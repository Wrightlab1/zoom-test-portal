# Copy to .env and adjust. Never commit .env.
# Master key: either set ZTP_MASTER_KEY (base64, 32 bytes) or let the portal
# create/read a key file (default ~/.config/zoom-test-portal/master.key, mode 0600).
# ZTP_MASTER_KEY=
# ZTP_KEY_FILE=/absolute/path/outside/repo/master.key

# Database and other runtime data (default ./data)
# ZTP_DATA_DIR=./data

# Admin UI/API listener. Loopback only unless you explicitly opt in.
# ZTP_ADMIN_HOST=127.0.0.1
# ZTP_ADMIN_PORT=4800
# ZTP_ADMIN_ALLOW_NON_LOOPBACK=0
# Extra Host header values accepted by the admin listener (comma separated)
# ZTP_ADMIN_ALLOWED_HOSTS=

# Public listener (OAuth callback + webhooks only). ngrok forwards here.
# ZTP_PUBLIC_HOST=127.0.0.1
# ZTP_PUBLIC_PORT=4801
